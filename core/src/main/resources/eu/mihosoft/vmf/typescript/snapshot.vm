export class ModelSnapshot {
    static readonly registry = new vmf.SnapshotRegistry([
#foreach($type in $registrations)
        {
            wireName: ${type.wireName},
            runtimeType: ${type.name},
            create: () => new ${type.name}(),
            properties: [
#foreach($property in $type.properties)
                {
                    wireName: ${property.wireName}, kind: "${property.kind}", ${property.data},
                    ${property.getter},
                    ${property.mutator},
                },
#end
            ],
            writeType: ${type.writeType},
#if($type.immutable)
            immutable: true,
            createWith: values => new ${type.name}(values as ConstructorParameters<typeof ${type.name}>[0]),
#end
        },
#end
    ], {
#foreach($alias in $aliases)
        [${alias.name}]: ${alias.target},
#end
    });

    static write(root: object): string {
        return vmf.SnapshotJson.write(root, this.registry);
    }

    static read<T extends object>(json: string, rootType: vmf.ModelConstructor<T>): T {
        return vmf.SnapshotJson.read(json, rootType, this.registry);
    }

    static writePlain<T extends object>(root: T, rootType: vmf.ModelConstructor<T>,
                                        references: Exclude<vmf.ReferenceMode, "ids"> = "reject"): string {
        return vmf.SnapshotJson.writePlain(root, rootType, this.registry, references);
    }

    static readPlain<T extends object>(json: string, rootType: vmf.ModelConstructor<T>): T {
        return vmf.SnapshotJson.readPlain(json, rootType, this.registry);
    }
}
