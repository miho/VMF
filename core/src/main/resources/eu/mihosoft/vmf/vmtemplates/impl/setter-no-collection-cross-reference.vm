#if(${prop.propType} != "COLLECTION" && !${prop.container} && !${prop.contained} && ${prop.crossRefProperty})
  // this property holds a (cross-)reference which is indicated by the @Refers annotation (see model type ${type.typeName})
  // ----------------------------------------
  // - cross-ref: 
  //   -> prop:
  //      -> name:       ${prop.name}  
  //      -> propType:   ${prop.typeName}      
  //   -> opposite:      true, ${prop.referenceInfo.opposite.typeName}.${prop.referenceInfo.opposite.name}
  //      -> propType:   ${prop.referenceInfo.opposite.typeName}
  //      -> collection: false
  // ----------------------------------------

  // ----------------------------------------
  // return early if identical value has been set
  // ----------------------------------------
  if (this.__vmf_prop_${prop.name} == ${prop.name}) {
    return;
  }
  if (this.__vmf_reference_pending_${prop.name}) {
    throw new IllegalArgumentException("A reference update for '${prop.name}' is already in progress");
  }
  // ----------------------------------------


#if(${prop.referenceInfo.opposite.propType} == "COLLECTION")## collection opposite 

  ${prop.typeName} oldValue = this.__vmf_prop_${prop.name};
  Throwable observerFailure = null;
  var oldRefs = oldValue == null ? null : ${prop.referenceInfo.opposite.internalGetter("oldValue")};
  try (var removal = ${VMFPKG_INT}.OppositeReferenceRemoval.begin(oldRefs, this)) {
    boolean observed = oldRefs != null || _vmf_hasPropertyChangeListeners();
    if (observed) this.__vmf_reference_pending_${prop.name} = true;
    try {
    if (oldRefs != null) {
      // Keep this removal primary so native undo can restore the original index.
      for (int index = 0; index < oldRefs.size(); index++) {
        if (oldRefs.get(index) == this) {
          try {
            oldRefs.remove(index);
          } catch (RuntimeException | Error failure) {
            observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
          }
          break;
        }
      }
    }

    boolean clearedByRemoval = oldValue != null && this.__vmf_prop_${prop.name} == null;
    this.__vmf_prop_$prop.name = $prop.name;
    try {
      _vmf_firePropertyChangeIfListenersArePresent("$prop.name", oldValue, this.__vmf_prop_$prop.name,
          clearedByRemoval ? ${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_SCALAR_AFTER_OPPOSITE_REMOVAL : "");
    } catch (RuntimeException | Error failure) {
      observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
    }
    } finally {
      if (observed) this.__vmf_reference_pending_${prop.name} = false;
    }

    if (this.__vmf_prop_${prop.name} != null) {
      var opposite = ${prop.referenceInfo.opposite.internalGetter("this.__vmf_prop_${prop.name}")};
      try {
        ${VMFPKG_INT}.ObservableModelList.addCrossReference(opposite, this);
      } catch (RuntimeException | Error failure) {
        observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
      }
    }
  }
  ${VMFPKG_INT}.ObserverFailures.rethrow(observerFailure);
#else##                                                        collection opposite
  var target = (__VMF_TYPE_${prop.type.implementation.typeName})${prop.name};
  if (target != null && target.__vmf_is_reference_pending_${prop.referenceInfo.opposite.name}()) {
    throw new IllegalArgumentException("The opposite reference '${prop.referenceInfo.opposite.name}' is already updating");
  }
  var oldTarget = (__VMF_TYPE_${prop.type.implementation.typeName})this.__vmf_prop_${prop.name};
  var previousOwner = target == null ? null : (__VMF_TYPE_${prop.referenceInfo.opposite.relationshipTarget.implementation.typeName})
          target.__vmf_get_prop_${prop.referenceInfo.opposite.name}();
  if (propertyChanges != null
      || (oldTarget != null && oldTarget._vmf_hasPropertyChangeListeners())
      || (target != null && target._vmf_hasPropertyChangeListeners())
      || (previousOwner != null && previousOwner != this && previousOwner._vmf_hasPropertyChangeListeners())) {
    __vmf_set_reference_with_observers_${prop.name}(${prop.name}, target, oldTarget, previousOwner);
    return;
  }
  if (previousOwner != null && previousOwner != this) {
    previousOwner.__vmf_set_prop_${prop.name}(null);
  }
  this.__vmf_prop_${prop.name} = ${prop.name};
  if (oldTarget != null && oldTarget.__vmf_get_prop_${prop.referenceInfo.opposite.name}() == this) {
    oldTarget.__vmf_set_prop_${prop.referenceInfo.opposite.name}(null);
  }
  if (target != null) target.__vmf_set_prop_${prop.referenceInfo.opposite.name}(this);
#end##                                                         collection opposite 

#end##
