#if($prop.propType == "COLLECTION" && $prop.contained && !$prop.crossRefProperty)##      COLLECTION PROP
    // this property holds a collection of objects that are contained in this instance (${type.typeName})

    // perform lazy initialization
    if(this.__vmf_prop_$prop.name==null) {
        this.__vmf_prop_$prop.name = ${VMFPKG_INT}.ContainmentList.newInstance(this, __vmf_get_prop_${prop.name}__vmf_RawList());

        this.__vmf_prop_${prop.name}.addChangeListener( (evt) -> {
            if (${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CONTAINMENT.equals(evt.eventInfo())) return;

            for (Object child : evt.added().elements()) {
                if (child == null) continue;
                ${VMFPKG_INT}.VObjectInternalModifiable valueInternal = (${VMFPKG_INT}.VObjectInternalModifiable)child;

                // The list already contains the incoming values. Check the owner's
                // other properties before treating a SET as a same-list reorder.
                if (valueInternal._vmf_getContainer() == this) {
                    if (!valueInternal._vmf_unregisterFromContainers(this.__vmf_prop_${prop.name}, evt.wasSet())) continue;
                } else {
                    valueInternal._vmf_unregisterFromContainers();
                }

                // register with this container
                ${VMFPKG}.VObject oldContainer = valueInternal._vmf_getContainer();
                valueInternal._vmf_setContainer(this);
#if(${prop.containmentInfo.opposite})## opposite
                valueInternal._vmf_setContainerPropertyId(valueInternal._vmf_getPropertyIdByName("${prop.containmentInfo.opposite.name}"));
                ((__VMF_TYPE_${prop.genericTypeName}Impl)valueInternal)._vmf_firePropertyChangeIfListenersArePresent("${prop.containmentInfo.opposite.name}", oldContainer, this, ${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CONTAINMENT);
#else##                                      ## opposite
                valueInternal._vmf_setContainerPropertyId(-1);
                ((__VMF_TYPE_${prop.genericTypeName}Impl)valueInternal)._vmf_firePropertyChangeIfListenersArePresent("__vmf_prop_unnamed_container", oldContainer, this, ${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CONTAINMENT);
#end##                                       ## opposite
            }

            java.util.List<?> removed = evt.removed().elements();
            if (!removed.isEmpty()) {
                // Collections.swap uses two SETs. An identity can occur twice
                // between them and still belong here after one occurrence is removed.
                java.util.Set<Object> remainingChildren = null;
                if (removed.size() > 1) {
                    remainingChildren = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
                    remainingChildren.addAll(this.__vmf_prop_${prop.name});
                }
                removedChildren:
                for (Object child : removed) {
                    if (child == null) continue;
                    if (remainingChildren == null) {
                        for (Object remaining : this.__vmf_prop_${prop.name}) {
                            if (remaining == child) continue removedChildren;
                        }
                    } else if (remainingChildren.contains(child)) {
                        continue;
                    }
                    ${VMFPKG_INT}.VObjectInternalModifiable valueInternal = (${VMFPKG_INT}.VObjectInternalModifiable)child;
                    if (valueInternal._vmf_getContainer() == this) valueInternal._vmf_unregisterFromContainers();
                }
            }
        }); // end of addChangeListener
             

    } // end of "lazy init" if(this.__vmf_prop_$prop.name==null)

    // return the collection
    return this.__vmf_prop_$prop.name;
#end##                                                                                   COLLECTION PROP
