  @Override
  public Object _vmf_getPropertyValueById(int propertyId) {

    switch(propertyId) {
#foreach($prop in $type.implementation.properties)
      case $foreach.index:
        // TODO check whether we can prevent lazy initialized properties from
        //      being initialized just for iterating the object graph
#if($prop.referenceSet)
        return __vmf_get_prop_${prop.name}();
#else
        return ${prop.getterPrefix}${prop.nameWithUpperCase}();
#end
#end## for-each property
    }

    return null;
  }

#if($type.hasReferenceSets())
  @Override public Object _vmf_getPublicPropertyValueById(int propertyId) {
    switch (propertyId) {
#foreach($prop in $type.implementation.properties)
#if($prop.referenceSet)
      case $foreach.index: return ${prop.getterPrefix}${prop.nameWithUpperCase}();
#end
#end
      default: return _vmf_getPropertyValueById(propertyId);
    }
  }
#end

  @Override
  public int _vmf_getPropertyIdByName(String propertyName) {
    switch(propertyName) {
#foreach($prop in $type.implementation.properties)
      case "$prop.name":
        return $foreach.index;
#end## for-each property
      default:
        return -1;
    } // end switch
  }

#if(!$readOnlyVal)
  @Override
  public void _vmf_setPropertyValueById(int propertyId, Object value) {
    switch(propertyId) {
#foreach($prop in $type.implementation.properties)
#if($prop.referenceSet)
      case $foreach.index:
        ${VMFPKG}.internal.ReferenceCollections.copy(__vmf_get_prop_${prop.name}(), (Iterable<? extends ${prop.elementTypeName}>) value, false);
        break;
#elseif($prop.keyed)
      case $foreach.index:
        ${VMFPKG}.internal.KeyedEntries.copy(get${prop.nameWithUpperCase}(),
            (java.util.Collection<${prop.elementTypeName}>) value, false);
        break;
#elseif(!$prop.genericType)
#if($prop.managedValues)
      case $foreach.index:
        ${VMFPKG}.internal.ManagedValues.copy(get${prop.nameWithUpperCase}(), (java.util.Collection<?>) value, false);
        break;
#elseif($prop.mapType)
      case $foreach.index:
        ${VMFPKG}.internal.ManagedMaps.copyInto(get${prop.nameWithUpperCase}(), (java.util.Map<?, ?>) value,
            ${prop.mapKeyTypeName}.class, ${prop.mapValueTypeName}.class, ${prop.upperBound}, false);
        break;
#elseif(${prop.propType}!="COLLECTION" && !${prop.readOnly}) ## && $prop.containmentInfo.containmentType!="CONTAINER"
      case $foreach.index: // normal property (no collection)
        set${prop.nameWithUpperCase}((${prop.typeName})value);
        break;
#elseif(${prop.propType}=="COLLECTION")
      case $foreach.index: // collection property
        get${prop.nameWithUpperCase}().clear();
        get${prop.nameWithUpperCase}().addAll((${prop.typeName})value);
        break;
#end## end if !collection
#end## end if !genericType
#end## for-each property
      default:
            throw new RuntimeException("Cannot set property with id="+propertyId +": property is not writable.");
    } // end switch
  }
#end## if !readOnlyVal

  @Override
  public Object _vmf_getDefaultValueById(int propertyId) {

    switch(propertyId) {
#foreach($prop in ${type.implementation.properties})
      case ${foreach.index}:
        Object __vmf_default_value_tmp${prop.nameWithUpperCase} = _VMF_DEFAULT_VALUES[${foreach.index}];
#if($prop.referenceSet)
#if($readOnlyVal && !$type.immutable)
        return ((java.util.List<${prop.elementTypeName}>) ((${VMFPKG}.internal.VObjectInternal) mutableObject)._vmf_getDefaultValueById(propertyId))
            .stream().map(e -> e.asReadOnly()).collect(java.util.stream.Collectors.toUnmodifiableList());
#else
        if (__vmf_default_value_tmp${prop.nameWithUpperCase} != null) return __vmf_default_value_tmp${prop.nameWithUpperCase};
#if(${prop.getDefaultValueAsString()}=="null")
        return java.util.List.of();
#else
        return __vmf_declared_default_${prop.name};
#end
#end
#elseif($prop.managedValues)
#if($readOnlyVal && !$type.immutable)
        return ((${VMFPKG}.internal.VObjectInternal) this.mutableObject)._vmf_getDefaultValueById(propertyId);
#else
        if (__vmf_default_value_tmp${prop.nameWithUpperCase} != null) return __vmf_default_value_tmp${prop.nameWithUpperCase};
#if(${prop.getDefaultValueAsString()}=="null")
#if($prop.setType)
        return java.util.Collections.emptySet();
#else
        return java.util.Collections.emptyList();
#end
#else
        return ${VMFPKG}.internal.ManagedValues.snapshot(${prop.getDefaultValueAsString()}, ${prop.constrainedElementType}.class, ${prop.upperBound}, ${prop.setType}, ${prop.unique});
#end
#end
#elseif($prop.mapType)
#if($readOnlyVal && !$type.immutable)
        return ((${VMFPKG}.internal.VObjectInternal) this.mutableObject)._vmf_getDefaultValueById(propertyId);
#else
        if (__vmf_default_value_tmp${prop.nameWithUpperCase} != null) {
          return __vmf_default_value_tmp${prop.nameWithUpperCase};
        }
#if(${prop.getDefaultValueAsString()}=="null")
        return java.util.Collections.emptyMap();
#else
        return ${VMFPKG}.internal.ManagedMaps.snapshot(${prop.getDefaultValueAsString()}, ${prop.mapKeyTypeName}.class, ${prop.mapValueTypeName}.class, ${prop.upperBound});
#end
#end
#elseif(${prop.propType}=="PRIMITIVE")## if prop is primitive
        if(__vmf_default_value_tmp${prop.nameWithUpperCase}==null) {
            return
#if(${prop.getDefaultValueAsString()}=="null")## if default is null
            #if(${prop.typeName}=="boolean")false#else 0#end;
#else## if default is null
            ${prop.getDefaultValueAsString()};
#end## if default is null
        } else {
            return __vmf_default_value_tmp${prop.nameWithUpperCase};
        }    
#else## if prop is primitive         
        if(__vmf_default_value_tmp${prop.nameWithUpperCase}==null) {
            return ${prop.getDefaultValueAsString()};
        } else {
            return __vmf_default_value_tmp${prop.nameWithUpperCase};
        }
#end## if prop is primitive

#end## for-each property
    } // end switch

    return null;
  }

  @Override
  public void _vmf_setDefaultValueById(int propertyId, Object defaultValue) {

#foreach($prop in ${type.implementation.properties})
#if($prop.referenceSet && !$prop.containmentProperty)
    if (propertyId == ${foreach.index} && defaultValue != null) {
      defaultValue = ${VMFPKG}.internal.ReferenceCollections.snapshot((Iterable) defaultValue, ${prop.elementTypeName}.class);
    }
#elseif($prop.managedValues)
    if (propertyId == ${foreach.index} && defaultValue != null) {
      defaultValue = ${VMFPKG}.internal.ManagedValues.snapshot((java.util.Collection<?>) defaultValue, ${prop.constrainedElementType}.class, ${prop.upperBound}, ${prop.setType}, ${prop.unique});
    }
#elseif($prop.mapType)
    if (propertyId == ${foreach.index}) {
      defaultValue = defaultValue == null ? null :
          ${VMFPKG}.internal.ManagedMaps.snapshot((java.util.Map<?, ?>) defaultValue, ${prop.mapKeyTypeName}.class, ${prop.mapValueTypeName}.class, ${prop.upperBound});
    }
#elseif(${prop.containmentProperty})
    // property ${prop.name}
    if(propertyId == ${foreach.index}) {
      throw new RuntimeException("Cannot set default value for property '${prop.name}' with id="+propertyId +": property is a containment property and not writable.");
    }
#end## if is containment
#end##for each property    

#if(!$readOnlyVal)
    // if the value was previously unset then we need to update
    // the value to the new default value
    boolean isSetBeforeDefaultUpdate = _vmf_isSetById(propertyId);
    _VMF_DEFAULT_VALUES[propertyId] = defaultValue;
    if(!isSetBeforeDefaultUpdate) {
      _vmf_unsetById(propertyId);
    }
#end## if !readOnlyVal
  }

  @Override
  public boolean _vmf_isSetById(int propertyId) {
#if($type.hasReferenceSets())
    switch (propertyId) {
#foreach($prop in $type.implementation.properties)
#if($prop.referenceSet)
      case $foreach.index: return !${VMFPKG}.internal.ReferenceCollections.sameMembers(
          (Iterable<?>) _vmf_getDefaultValueById(propertyId), __vmf_get_prop_${prop.name}(), ${prop.ordered});
#end
#end
      default: break;
    }
#end
    return !java.util.Objects.equals(_vmf_getDefaultValueById(propertyId), _vmf_getPropertyValueById(propertyId));
  }

#if(!$readOnlyVal)
  @Override
  public void _vmf_unsetById(int propertyId) {
    _vmf_setPropertyValueById(propertyId, _vmf_getDefaultValueById(propertyId));
  }
#end## if !readOnlyVal

  final Object[] _VMF_DEFAULT_VALUES = {
#foreach($prop in ${type.implementation.properties}) 
    null#if(${foreach.hasNext}),#else #end // type ${prop.name} #if(${prop.containmentProperty})(containment type, no defaut value possible)#end
  
#end## for each property
  };

