  // --------------------------- BEGIN EQUALITY -----------------------------

  @Override
  public boolean _vmf_equals(Object o) {
#if(!$type.immutable)
    if (o instanceof $type.readOnlyImplementation.typeName) {
      o = (($type.readOnlyImplementation.typeName) o)._vmf_getMutableObject();
    }
#end
    if (this == o) return true;
    if (o == null || o.getClass() != ${type.implementation.typeName}.class) return false;

    var other = (${type.implementation.typeName}) o;
    var pair = new ${VMFPKG_INT}.VObjectInternal.EqualsPair(this, other);
    int depth = pair.enterDepth();
    if (depth == 0) return true;
    try {
      if (depth >= ${VMFPKG_INT}.StructuralContentEquality.RECURSIVE_LIMIT
          && getClass() == ${type.implementation.typeName}.class) {
        return ${VMFPKG_INT}.StructuralContentEquality.compareEntered(this, other);
      }
      return #if($type.implementation.propertiesForEquals.isEmpty())true;#end
#foreach ($prop in $type.implementation.propertiesForEquals)
#if($prop.referenceSet && !$prop.ordered)
        ${VMFPKG_INT}.ReferenceContent.unorderedEquals(this.__vmf_prop_${prop.name}, other.__vmf_prop_${prop.name},
          (left, right) -> _vmf_equals_helper(left, right))#if($foreach.hasNext) &&#else;#end
#else
        _vmf_equals_helper(this.__vmf_prop_$prop.name, other.__vmf_prop_$prop.name)#if($foreach.hasNext) &&#else;#end
#end
#end
    } finally {
      pair.leave();
    }
  }

  private static boolean _vmf_equals_helper(Object left, Object right) {
    if (left == right) return true;
    if (left instanceof ${VCOLL_PKG}.VList<?>) {
      var list = (${VCOLL_PKG}.VList<?>) left;
      if (right == null) return list.isEmpty();
      if (!(right instanceof ${VCOLL_PKG}.VList<?>)) return false;
      var other = (${VCOLL_PKG}.VList<?>) right;
      if (list.size() != other.size()) return false;
      for (int index = 0; index < list.size(); index++) {
        if (!_vmf_equals_helper(list.get(index), other.get(index))) return false;
      }
      return true;
    }
    if (right instanceof ${VCOLL_PKG}.VList<?>) {
      return left == null && ((${VCOLL_PKG}.VList<?>) right).isEmpty();
    }
    if (left instanceof ${VMFPKG_INT}.VObjectInternal && right instanceof ${VMFPKG_INT}.VObjectInternal) {
      return ((${VMFPKG_INT}.VObjectInternal) left)._vmf_equals(right);
    }
    return java.util.Objects.equals(left, right);
  }

  @Override
  public int _vmf_equalityFieldCount(${VMFPKG_INT}.VObjectInternal other) {
#set($count = $type.implementation.propertiesForEquals.size())
    if (getClass() != ${type.implementation.typeName}.class) return -1;
    return other.getClass() == ${type.implementation.typeName}.class ? $count : -2;
  }

  @Override
  public void _vmf_prepareEqualityField(int index, ${VMFPKG_INT}.VObjectInternal other,
          ${VMFPKG_INT}.StructuralContentEquality.Field field) {
    var compared = (${type.implementation.typeName}) other;
    switch (index) {
#foreach ($prop in $type.implementation.propertiesForEquals)
      case ${foreach.index}:
#if($prop.referenceSet && !$prop.ordered)
        field.unordered(this.__vmf_prop_${prop.name}, compared.__vmf_prop_${prop.name});
#else
        field.value(this.__vmf_prop_${prop.name}, compared.__vmf_prop_${prop.name});
#end
        return;
#end
      default: throw new IndexOutOfBoundsException(index);
    }
  }

  @Override
  public int _vmf_hashCode() {
    return ${VMFPKG_INT}.StructuralContentHash.hash(this);
  }

  @Override
  public void _vmf_collectHashFields(${VMFPKG_INT}.StructuralContentHash.Fields fields) {
#foreach ($prop in $type.implementation.propertiesForEquals)
#if($prop.referenceSet)
    fields.list(this.__vmf_prop_${prop.name}, ${prop.ordered});
#else
    fields.value(this.__vmf_prop_${prop.name});
#end
#end
  }

#if(${type.isEqualsMethodDelegated()})
  // -> equals(Object o) and hashCode() methods are delegated
#elseif(${type.isEqualsAndHashCode()})## #if(${type.isEqualsMethodDelegated()}) 
  // we use VMF's equals & hashCode implementation
  @Override
  public boolean equals(Object o) {
    return _vmf_equals(o);
  }
  @Override
  public int hashCode() {
    return _vmf_hashCode();
  }
