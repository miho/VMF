#if(!${type.immutable})

  //--------------------------------------------------------------------------------
  // containment prop (for storing reference to container)
  //--------------------------------------------------------------------------------
  /*TODO make private package private*/ ${VMFPKG}.VObject __vmf_internal_container;
  @Override public ${VMFPKG}.VObject _vmf_getContainer() {return this.__vmf_internal_container;}
  @Override public void _vmf_setContainer(${VMFPKG}.VObject container) {this.__vmf_internal_container = container;}
  @Override public int _vmf_getContainerPropertyId() {return this.__vmf_internal_container_prop_id;}
  @Override public void _vmf_setContainerPropertyId(int id) {this.__vmf_internal_container_prop_id=id;}
  // id of the container property (the opposite of the containment property this
  // object is contained through); -1 if there is none or the containment has no
  // opposite, so that a container getter never reports a container of another kind
  private int __vmf_internal_container_prop_id = -1;
  //--------------------------------------------------------------------------------
#end

#if(!${type.immutable})
  // dynamic behavior
  private ${type.typeName}.Behavior __vmf_dynamicBehavior;
#end

#set($tracksContainmentSlots = false)
#foreach( $prop in ${type.implementation.properties})
#set($singularContainment = $prop.propType != "COLLECTION" && !$prop.container && $prop.contained && !$prop.crossRefProperty)
  // --- PROP '$prop.typeName'
#if(!$type.immutable && $singularContainment)
#set($tracksContainmentSlots = true)
  private long __vmf_containment_revision_${prop.name};
#end
#if($prop.propType == "COLLECTION" && ($prop.hasUniqueReferenceOpposite() || $prop.hasOrdinaryReferenceListOpposite()))
  private long __vmf_reference_revision_${prop.name};
#end
#if($prop.referenceSet)
  private ${prop.typeNameForInterface} __vmf_refs_${prop.name};
#if($prop.hasReferenceDefault())
  private java.util.List<${prop.elementTypeName}> __vmf_declared_default_${prop.name};
#end
#end
#if($prop.managedValues)
    private final $prop.typeName __vmf_prop_$prop.name =
#if($prop.setType)
      ${VCOLL_PKG}.VSet.checked(${prop.constrainedElementType}.class, ${prop.upperBound});
#else
      ${VMFPKG}.internal.ManagedValues.list(${prop.constrainedElementType}.class, ${prop.upperBound}, ${prop.unique});
#end
#elseif($prop.mapType)
  private final $prop.typeName __vmf_prop_$prop.name =
      ${VMFPKG}.internal.ManagedMaps.create(${prop.mapKeyTypeName}.class, ${prop.mapValueTypeName}.class, ${prop.upperBound});
#else
  /*package private*/ $prop.typeName __vmf_prop_$prop.name;
#end
#if(${prop.propType} == "COLLECTION")
  /*package private*/ java.util.List<${prop.genericPackageName}.${prop.genericTypeName}> __vmf_prop_${prop.name}__vmf_RawList;
#end## collection  
#if(!$type.immutable) 
#if($prop.managedValues)
  @Override public void __vmf_set_prop_${prop.name}($prop.typeName obj) {
    ${VMFPKG}.internal.ManagedValues.copy(__vmf_prop_${prop.name}, obj, false);
  }
#elseif($prop.mapType)
  @Override public void __vmf_set_prop_${prop.name}($prop.typeName obj) {
    ${VMFPKG}.internal.ManagedMaps.copyInto(__vmf_prop_${prop.name}, obj, ${prop.mapKeyTypeName}.class, ${prop.mapValueTypeName}.class, ${prop.upperBound}, false);
  }
#elseif($prop.referenceSet)
  @Override public void __vmf_set_prop_${prop.name}($prop.typeName obj) {
    ${VMFPKG}.internal.ReferenceCollections.copy(__vmf_get_prop_${prop.name}(), obj, false);
  }
#elseif($singularContainment)
#if($prop.isInheritedProp())
  @Override public void __vmf_set_prop_${prop.name}(${prop.inheritedProp.typeName} obj) {
#else
  @Override public void __vmf_set_prop_${prop.name}($prop.typeName obj) {
#end
    if (this.__vmf_prop_${prop.name} == obj) return;
    this.__vmf_prop_${prop.name} = ($prop.typeName) obj;
    this.__vmf_containment_revision_${prop.name}++;
  }
#elseif(${prop.isInheritedProp()})## if   inheritedprop
  //  -> prop is inherited from: '${prop.inheritedProp.parent.typeName}.${prop.inheritedProp.name}'
  //  -> we have to stick to the parent method signature and do the necessary casting in the setter impl, see (*1*) 
  @Override public void __vmf_set_prop_${prop.name}(${prop.inheritedProp.typeName} obj) {this.__vmf_prop_${prop.name} = /* (*1*) */($prop.typeName)obj;}
#else##------------------------- else inheritedprop
  @Override public void __vmf_set_prop_${prop.name}($prop.typeName obj) {this.__vmf_prop_${prop.name} = obj;}
#end##-------------------------- end  inheritedprop
  //@Override public void __vmf_set_prop_${prop.name}($prop.typeName obj) {this.__vmf_prop_${prop.name} = obj;}
#if(!$prop.referenceSet)
  @Override public $prop.typeName __vmf_get_prop_${prop.name}() {return this.__vmf_prop_${prop.name};}
#end
#if(${prop.propType} == "COLLECTION")
  @Override public java.util.List<${prop.genericPackageName}.${prop.genericTypeName}> __vmf_get_prop_${prop.name}__vmf_RawList() {

    if(this.__vmf_prop_${prop.name}__vmf_RawList==null) {
  	  __vmf_prop_${prop.name}__vmf_RawList = new java.util.ArrayList<>();
    }

    return this.__vmf_prop_${prop.name}__vmf_RawList;
  };
#end## collection
#end## is not immutable  
#end

#if($tracksContainmentSlots)
  @Override public long _vmf_getContainmentSlotRevision(int propertyId) {
    switch (propertyId) {
#foreach($prop in $type.implementation.properties)
#if($prop.propType != "COLLECTION" && !$prop.container && $prop.contained && !$prop.crossRefProperty)
      case $foreach.index: return __vmf_containment_revision_${prop.name};
#end
#end
      default: return 0;
    }
  }
#end
