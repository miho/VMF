#if(${prop.propType} != "COLLECTION" && !${prop.container} && !${prop.contained} && ${prop.crossRefProperty} && ${prop.referenceInfo.opposite.propType} != "COLLECTION")
private void __vmf_set_reference_with_observers_${prop.name}(
        ${prop.typeName} ${prop.name}, __VMF_TYPE_${prop.type.implementation.typeName} target,
        __VMF_TYPE_${prop.type.implementation.typeName} oldTarget,
        __VMF_TYPE_${prop.referenceInfo.opposite.relationshipTarget.implementation.typeName} previousOwner) {
  ${prop.typeName} oldValue = oldTarget;
  this.__vmf_reference_pending_${prop.name} = true;
  if (target != null) target.__vmf_set_reference_pending_${prop.referenceInfo.opposite.name}(true);
  Throwable observerFailure = null;
  Object refOldVal = null;
  try {
  // Release an occupied target before registering this owner. Retain this
  // primary owner change so transaction undo can restore the displaced pair.
  if (previousOwner != null && previousOwner != this) {
    previousOwner.__vmf_set_prop_${prop.name}(null);
    try {
      previousOwner._vmf_firePropertyChangeIfListenersArePresent("${prop.name}", $prop.name, null);
    } catch (RuntimeException | Error failure) {
      observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
    }
  }
  // ----------------------------------------
  // set the new value
  // ----------------------------------------
  this.__vmf_prop_$prop.name = $prop.name;
  // ----------------------------------------

  // ----------------------------------------
  // remove this object as reference from old value
  // ----------------------------------------
  if(oldTarget!=null) {
    if(oldTarget.__vmf_get_prop_${prop.referenceInfo.opposite.name}() == this) {
      oldTarget.__vmf_set_prop_${prop.referenceInfo.opposite.name}(null);
      try {
        oldTarget._vmf_firePropertyChangeIfListenersArePresent("${prop.referenceInfo.opposite.name}", this, null, ${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CROSS_REF);
      } catch (RuntimeException | Error failure) {
        observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
      }
    }
  }
  // ----------------------------------------

  // ----------------------------------------
  // fire property change event
  // ----------------------------------------
  try {
    _vmf_firePropertyChangeIfListenersArePresent("$prop.name", oldValue, this.__vmf_prop_$prop.name);
  } catch (RuntimeException | Error failure) {
    observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
  }

  // ----------------------------------------
  // register this with opposite if new value is not null
  // ----------------------------------------
  if (target != null) {
      refOldVal = target.__vmf_get_prop_${prop.referenceInfo.opposite.name}();
      target.__vmf_set_prop_${prop.referenceInfo.opposite.name}(this);
  }
  } finally {
    this.__vmf_reference_pending_${prop.name} = false;
    if (target != null) target.__vmf_set_reference_pending_${prop.referenceInfo.opposite.name}(false);
  }
  if (target != null && refOldVal != this) {
      try {
        target._vmf_firePropertyChangeIfListenersArePresent("${prop.referenceInfo.opposite.name}", refOldVal, this, ${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CROSS_REF);
      } catch (RuntimeException | Error failure) {
        observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
      }
  }
  // ----------------------------------------
  ${VMFPKG_INT}.ObserverFailures.rethrow(observerFailure);
}
#end
