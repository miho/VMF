#if($prop.propType == "COLLECTION" && !$prop.contained && $prop.crossRefProperty)##      COLLECTION PROP
    // this property holds a collection of objects which are (cross-)referenced as
    // indicated by the @Refers annotation (see model type ${type.typeName})

    // perform lazy initialization
    if(this.__vmf_prop_$prop.name==null) {
        this.__vmf_prop_$prop.name = ${VMFPKG_INT}.ObservableModelList.newInstance(__vmf_get_prop_${prop.name}__vmf_RawList());

        this.__vmf_prop_${prop.name}.addChangeListener(evt -> {
            if (${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CROSS_REF.equals(evt.eventInfo())) return;

            Throwable observerFailure = null;
            for (var e : evt.added().elements()) {
                if (e == null) continue;
                var target = (${prop.parent.packageName}.impl.__VMF_TYPE_${prop.genericTypeName}Impl) e;
#if(${prop.referenceInfo.opposite.propType} == "COLLECTION")
                var opposite = target.get${prop.referenceInfo.opposite.nameWithUpperCase}();
                try {
                    ${VMFPKG_INT}.ObservableModelList.addCrossReference(opposite, this);
                } catch (RuntimeException | Error failure) {
                    observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
                }
#else
#set($oppositeRefProp=${prop.referenceInfo.opposite})
                var previousOwner = target.__vmf_get_prop_${oppositeRefProp.name}();
                if (previousOwner == this) {
                    var refs = this.__vmf_prop_${prop.name};
                    int first = -1;
                    for (int i = 0; i < refs.size(); i++) {
                        if (refs.get(i) != e) continue;
                        if (first == -1) {
                            first = i;
                            continue;
                        }
                        try {
                            ${VMFPKG_INT}.ObservableModelList.removeCrossReference(refs, first);
                        } catch (RuntimeException | Error failure) {
                            observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
                        }
                        break;
                    }
                    continue;
                }

                // Keep the old list removal in native history before the new list adds
                // its change. Undo can then restore the previous owner's entry and position.
                target.__vmf_set_prop_${oppositeRefProp.name}(this);
                if (previousOwner != null) {
                    var previousRefs = previousOwner.get${prop.nameWithUpperCase}();
                    for (int i = previousRefs.size() - 1; i >= 0; i--) {
                        if (previousRefs.get(i) == e) {
                            try {
                                previousRefs.remove(i);
                            } catch (RuntimeException | Error failure) {
                                observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
                            }
                        }
                    }
                }
                try {
                    target._vmf_firePropertyChangeIfListenersArePresent("${oppositeRefProp.name}", previousOwner, this,
                            ${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CROSS_REF);
                } catch (RuntimeException | Error failure) {
                    observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
                }
#end
            }

            removed:
            for (var e : evt.removed().elements()) {
                if (e == null) continue;
                var target = (${prop.parent.packageName}.impl.__VMF_TYPE_${prop.genericTypeName}Impl) e;
#if(${prop.referenceInfo.opposite.propType} == "COLLECTION")
                var opposite = target.get${prop.referenceInfo.opposite.nameWithUpperCase}();
                try {
                    ${VMFPKG_INT}.ObservableModelList.removeCrossReference(opposite, this);
                } catch (RuntimeException | Error failure) {
                    observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
                }
#else
#set($oppositeRefProp=${prop.referenceInfo.opposite})
                if (target.__vmf_get_prop_${oppositeRefProp.name}() != this) continue;
                for (Object remaining : this.__vmf_prop_${prop.name}) {
                    if (remaining == e) continue removed;
                }
                target.__vmf_set_prop_${oppositeRefProp.name}(null);
                try {
                    target._vmf_firePropertyChangeIfListenersArePresent("${oppositeRefProp.name}", this, null,
                            ${VMFPKG_INT}.ChangeInternal.CHANGE_TYPE_CROSS_REF);
                } catch (RuntimeException | Error failure) {
                    observerFailure = ${VMFPKG_INT}.ObserverFailures.add(observerFailure, failure);
                }
#end
            }
            ${VMFPKG_INT}.ObserverFailures.rethrow(observerFailure);
        });

    } // end of "lazy init" if(this.__vmf_prop_$prop.name==null)
    
    // return the collection
    return this.__vmf_prop_$prop.name;
#end##                                                                                    COLLECTION PROP