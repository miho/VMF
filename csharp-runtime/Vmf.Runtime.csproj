<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The version comes from VMF's publication.version: ./gradlew :vmf:packCSharpRuntime -->
    <PackageId>Vmf.Runtime</PackageId>
    <Authors>Michael Hoffer</Authors>
    <Description>Runtime library for C# models generated by VMF.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/miho/VMF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miho/VMF</RepositoryUrl>
    <PackageTags>vmf;modeling;code-generation</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
