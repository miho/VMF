<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vmf.Performance</RootNamespace>
    <AssemblyName>VmfPerformance</AssemblyName>
    <!-- Workstation garbage collection, like a desktop or command-line application that uses a model. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../csharp-runtime/Vmf.Runtime.csproj" />
    <!-- Generated by generatePerformanceModelsCSharp from the model of the Java lane (../vmf). -->
    <Compile Include="../../../../build/performance/csharp/generated/**/*.cs" />
  </ItemGroup>
</Project>
